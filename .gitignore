# --- Runtime / user data ----------------------------------------------------
# The app stores models, versions, checkpoints, replays, logs and settings in a
# per-user data folder OUTSIDE this repository (%LOCALAPPDATA%\OsuManiaAI on
# Windows, see maniabot/storage.py). These rules are a second line of defence
# for the legacy CLI scripts and for anything written here by mistake.
/runs/
/replays/
/models/
/checkpoints/
/logs/
/cache/
/datasets/
/training_data/
/user_data/
/runtime/
/local_data/
/tensorboard/

